# Agent Office configuration

# Database (leave empty for SQLite default - zero config)
# For PostgreSQL: DATABASE_URL=postgres://user:pass@localhost:5432/agent_office
# DATABASE_URL=

# Telegram Bot (optional - get token from @BotFather)
# TELEGRAM_BOT_TOKEN=

# Integrations (all optional)
# SLACK_WEBHOOK_URL=
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# LINEAR_API_KEY=
# LINEAR_WEBHOOK_SECRET=
# LINEAR_TEAM_ID=

# Chat providers (optional; an agent picks one under Runtime > Provider).
# These run as plain chat: no shell, files or MCP connectors.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MIMO_API_KEY=
# OLLAMA_URL=http://localhost:11434
# Optional endpoint overrides (proxies, tests): OPENAI_BASE_URL, DEEPSEEK_BASE_URL, MIMO_BASE_URL

# Server
# PORT=4173
